#!/usr/bin/env monkey -- 

let nums = [420, 69, 100, 101, 329];

printf("sorted nums='%v'", sort(nums));

printf("reversed nums='%v'", reverse(nums));

printf("First 3 nums='%v'", slice(nums, 0, 3));

printf("Index of 420='%v'", indexOf(nums, 420));

printf("Sum of nums='%v'", sum(nums));
printf("Len of nums='%v'", len(nums));
printf("Min of nums='%v'", min(nums));
printf("Max of nums='%v'", max(nums));

