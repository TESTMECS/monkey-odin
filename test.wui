-- WACKY
* -- Not
? -- Modulo
$ -- Comments
# -- IO 
@ -- allocator 
-- Swap the meanings?
>> -- quote 
<< -- unquote
// -- Generics/Compiletime
% -- If/Else
! -- Pointers

fn //T identity(x ::T) -> T {
    return x
}

% *isDebug {
    $ debugging disabled
} else {
    #print("Running program...")
}

v1 = @Vec2{{ x :1.0, y :2.0 }}
v2 = @Vec2{{ x :3.0, y :4.0 }}

fn add(a ::Vec2, b ::Vec2) -> Vec2 {
    return @Vec2{{ x :a.x + b.x, y :a.y + b.y }}
}

sum = add(v1, v2)

#write("Result: ", sum.x, ", ", sum.y)

p ::!int = @int(10)
#write(!p)   $ prints 10

code = >>add(1, <<x>>)

% x > 0 { #write("Positive") } else { #write("Negative") }

$ Program entry
fn main() -> int {
    #write("Hello!")

    % *debug {
        #write("Skipping debug mode...")
    } else {
        data = @Vec2{{ x :1, y :2 }}
        result = add(data, @Vec2{{ x :3, y :4 }})
        #print("Sum: ", result.x, ", ", result.y)
    }

    return 0
}

$ Fills a array with a given value
fn //T make_array(size ::int, fill ::T) -> [T] {
    % size <= 0 { return [] }

    code = >>[ <<fill>>, <<fill>>, <<fill>> ] $ "Code" is quoted to and fill
    return <<code>>
}

macro make_logger(tag) {
    return >>fn(msg) {
        #write("[", <<tag>>, "]: ", <<msg>>)
    }
}

info = make_logger("INFO")
warn = make_logger("WARN")

info("All systems normal")
warn("Disk usage high")

%Vec2{{ x ::float, y ::float }}

macro make_getter(field) {
    name = "get_" + field
    return >>fn(v ::Vec2) -> float { v.<<field>> }
}

get_x = make_getter("x")
get_y = make_getter("y")

v = @Vec2{{ x :10, y :20 }}
#print(get_x(v))   $ 10
#print(get_y(v))   $ 20

fn make_constant_expr(a ::int, b ::int) -> Expr {
    val = a * b
    return >><<val>> + 10
}

expr = make_constant_expr(3, 4)
#write(expr)  $ Expands to: 12 + 10
	
macro query(table, cond) {
    return >>"SELECT * FROM " + <<table>> + " WHERE " + <<cond>>
}

q = query("users", "age > 30")
#println(q)

binding ::= identifier [ "::" type ] "=" expr
x ::int = 42
name ::str = "Drew"
table ::!Vec2 = @Vec2{{ x :1, y :2 }}

a ::int = 10
b ::float = 2.5
c = 3 ? 2    $ 3 mod 2 = 1  (since ? is modulo)
number-literal ::= [0-9]+ ( "." [0-9]+ )?
numeric-expr   ::= number-literal
                 | identifier
                 | numeric-expr ("+" | "-" | "*" | "/" | "?") numeric-expr

s1 ::str = "Hello"
s2 = "World"
s3 = s1 + " " + s2

s4 = >>"Quoted string literal"
$$
2.3 Tables

Tables are central to your data model, and you’ve defined %TableType{{ key :value }} as the literal syntax.

Two assignment levels:

schema definition (%TypeName{{ key ::type }})

instance creation (@TypeName{{ key :value }})

Example:
$$

%Vec2{{ x ::float, y ::float }}
v ::Vec2 = @Vec2{{ x :1.0, y :2.0 }}

p ::!Vec2 = @Vec2{{ x :5, y :9 }}
!p.x = 10    $ modifies via pointer dereference

table-schema ::= "%" identifier "{{" (key "::" type ",")* key "::" type "}}"
table-value  ::= "@" identifier "{{" (key ":" expr ",")* key ":" expr "}}"

add = fn(a ::int, b ::int) -> int { a + b }
apply = fn(f ::(int)->int, x ::int) -> int { f(x) } -- anon

closure-expr ::= "fn" "(" params? ")" ["->" type] block

macro make_adder(n ::int) {
    return >>fn(x ::int) -> int { x + <<n>> }
}
make_adder = macro(n ::int) { ... }
make_adder ::(int)->fn(int)->int = macro(n) { ... }

$ Demonstrating assignment across types

%Vec2{{ x ::float, y ::float }}

n ::int = 10
msg ::str = "Count: " + "10"

v ::Vec2 = @Vec2{{ x :1.5, y :2.5 }}
p ::!Vec2 = @Vec2{{ x :0, y :0 }}
*p.x = 3.0

add = fn(a::int, b::int) -> int { a + b }

make_scaler = macro(f ::float) {
    return >>fn(v ::Vec2) -> Vec2 {
        @Vec2{{ x :v.x * <<f>>, y :v.y * <<f>> }}
    }
}


scale2 = make_scaler(2.0)
v2 = scale2(v)

#print(msg, " scaled to ", v2.x, ", ", v2.y)
$$
1. Operator Categories Overview

We’ll classify operators by phase (runtime vs compile-time) and domain (logical, arithmetic, structural, meta).

Precedence Level	Category	Operators	Associativity	Phase
1	Primary / Atomic	literals, identifiers, function calls, table access (a.b), grouping (...), table literals @T{{...}}	left	runtime
2	Quote / Unquote	>>, <<	right	compile-time
3	Pointer / Alloc / Not	!, @, * (as NOT)	right	runtime
4	Exponentiation	^ (if you add it later)	right	runtime
5	Multiplicative	*, /, ? (? = modulo)	left	runtime
6	Additive	+, -	left	runtime
7	Comparative	<, >, <=, >=	left	runtime
8	Equality	==, !=	left	runtime
9	Logical And/Or	&&, `		` (optional)
10	Conditional / Control	% (if/else)	right	runtime
11	Assignment / Declaration	=, ::	right	compile-time
12	Generics / Meta-declaration	//	non-associative	compile-time
$$

n = 2

% n {
    case 1 { #write("one") }
    case 2 { #write("two") }
    case 3 { #write("three") }
    else { #write("other") }
}

result = % n {
    case 1 { "A" }
    case 2 { "B" }
    else { "?" }
}

v = @Vec2{{ x :1, y :0 }}

switch-stmt ::= "%" expr "{" case-block+ [ "else" block ] "}"

case-block ::= "case" expr block
block       ::= "{" statement* "}"

% v {
    case @Vec2{{ x :1, y :_ }} { #write("x = 1") }
    case @Vec2{{ x :_, y :0 }} { #write("y = 0") }
    else { #write("no match") }
}

% expr { case val1 {...} case val2 {...} else {...} }
% expr == val1 { ... }
else % expr == val2 { ... }
else { ... }

macro enum_switch(x, pairs) {
    return >>%<<x>> { <<pairs>> }
}

enum_switch(color, >>case "red" { #write("Stop") } case "green" { #write("Go") }<<)

p ::!Vec2 = @Vec2{{ x | 3, y | 4 }}

% !p.x {
    case 0 { #write("origin") }
    case 3 { #write("x=3") }
    else { #write("unknown") }
}

color ::str = "red"

% color {
    case "red"   { #write("Stop") }
    case "yellow"{ #write("Wait") }
    case "green" { #write("Go") }
    else { #write("Invalid color") }
}

switch-expr ::= "%" expr "{" switch-body "}"
switch-body ::= (case-clause)+ [else-clause]
case-clause ::= "case" expr block
else-clause ::= "else" block

msg = %n{
    1:"one",
    2:"two",
    3:"three",
    else:"other"
}

%Vec2{{ x ::float, y ::float }}
v ::Vec2 = @Vec2{{ x => 3, y => 4 }}
v = @Vec2{{ x | 3, y | 4 }}

table-schema ::= "%" identifier "{{" (field-type ("," field-type)*)? "}}"
field-type   ::= identifier "::" type

table-value  ::= "@" identifier "{{" (field-value ("," field-value)*)? "}}"
field-value  ::= identifier "|" expr

p ::!Vec2 = @Vec2{{ x | 3, y | 4 }}
!p.x = 10
#write((!p).x)
$$ Desuggars to
p->x=10 $$ (!p).(x)= 10
#write(p->x) $$ (!p).x
$$ Tables with cases
v = @Vec2{{ x | 0, y | 10 }}

% v {
    case @Vec2{{ x | 0, y | _ }} { #write("Vertical axis") }
    case @Vec2{{ x | _, y | 0 }} { #write("Horizontal axis") }
    else { #write("Other") }
}

$ Define scaling function
fn scale(v ::Vec2, s ::float) -> Vec2 {
    return @Vec2{{ x | v.x * s, y | v.y * s }}
}
scaled = scale(a, 2)

p ::!Vec2 = @Vec2{{ x | 5, y | 9 }}
p->x = 10
#write("Pointer X: ", p->x)


